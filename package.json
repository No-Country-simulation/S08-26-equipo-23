{
  "name": "health-demand-data-generator",
  "version": "1.0.0",
  "description": "Generador de dataset sintético realista para HealthDemand",
  "main": "generate-medical-data.js",
  "scripts": {
    "generate": "node generate-medical-data.js",
    "load-mongo": "node load-to-mongodb.js",
    "load-postgres": "node load-to-postgresql.js",
    "load-xlsx": "node load-xlsx-to-postgresql.js",
